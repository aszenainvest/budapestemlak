# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens (required at runtime; also during `next build` / Docker
# unless you rely on Dockerfile build-time placeholder — production must use a strong secret)
PAYLOAD_SECRET=YOUR_SECRET_HERE

# --- MinIO / S3 (Railway) — aynı değişkenleri CMS servisine Variables olarak da ekle ---
# Sırları yalnızca Railway / yerel .env.local — repoya commit etme.
#
# Railway "service-account-credentials" JSON:
#   accessKey  → S3_ACCESS_KEY_ID
#   secretKey  → S3_SECRET_ACCESS_KEY
#   JSON içindeki "url" (…/api/v1/service-account-credentials) S3_ENDPOINT DEĞİL; kullanma.
#
# S3_ENDPOINT = MinIO S3 API (CMS ile aynı VPC: http://BUCKET-SERVICE.railway.internal:9000)
# Dışarıdan sync script: MinIO panelindeki gerçek S3 API HTTPS adresi.
#
# S3_BUCKET=aszena
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_ENDPOINT=http://bucket.railway.internal:9000
#
# Fotoğrafları yerel public/media → bucket: önce üstteki değişkenleri .env.local'e koy, sonra:
#   pnpm run sync:media-to-minio

# Public site URL (no trailing slash). On Railway/Docker set this to your https URL
# so images, CORS, and metadata resolve correctly.
#
# Yerelde: http://localhost:3000 — Production (örnek): https://cms-production-1ded.up.railway.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
