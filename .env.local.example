# Copy: cp .env.local.example .env.local
# Fill with Railway MinIO values (never commit .env.local)

S3_BUCKET=aszena
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Internal (CMS container): http://YOUR-MINIO-SERVICE.railway.internal:9000
# Laptop sync script: MinIO S3 API public HTTPS URL from Railway dashboard
S3_ENDPOINT=

# Public bucket tabanı (host veya host/aszena). Media API doğrudan https://.../aszena/dosya.png döner; Next/Image bileşeni yine /api/media/file ile yükler.
# NEXT_PUBLIC_MINIO_PUBLIC_URL=https://bucket-production-xx.up.railway.app
