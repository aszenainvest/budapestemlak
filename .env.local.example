# Copy: cp .env.local.example .env.local
# Fill with Railway MinIO values (never commit .env.local)

S3_BUCKET=aszena
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Internal (CMS container): http://YOUR-MINIO-SERVICE.railway.internal:9000
# Laptop sync script: MinIO S3 API public HTTPS URL from Railway dashboard
S3_ENDPOINT=

# Opsiyonel: doğrudan bucket testleri / script. Ön yüz img URL’leri Payload /api/media/file ile üretilir (MinIO’ya proxylanır).
# NEXT_PUBLIC_MINIO_PUBLIC_URL=https://your-minio-public.up.railway.app
