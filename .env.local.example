# Copy: cp .env.local.example .env.local
# Fill with Railway MinIO values (never commit .env.local)

S3_BUCKET=aszena
# Client-side bucket name (same as S3_BUCKET) if NEXT_PUBLIC_MINIO_PUBLIC_URL host-only:
# NEXT_PUBLIC_S3_BUCKET=aszena
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# Internal (CMS container): http://YOUR-MINIO-SERVICE.railway.internal:9000
# Laptop sync script: MinIO S3 API public HTTPS URL from Railway dashboard
S3_ENDPOINT=

# Public MinIO HTTPS (path ile .../aszena veya host-only + NEXT_PUBLIC_S3_BUCKET). Docker build'ta da aynı — yoksa Next/Image remotePatterns localhost kalır → 400.
# NEXT_PUBLIC_MINIO_PUBLIC_URL=https://bucket-production-xx.up.railway.app/aszena
# NEXT_PUBLIC_SERVER_URL=https://cms-xx.up.railway.app
